{
  // Every task that builds uses the same build folder with the same options
  // (warning level 2, warnings as errors). The script leaves a configured
  // folder alone, so a task only compiles what changed; a task that passed
  // other options would change every compile command and compile every file
  // again. See docs/manual/building-from-source.md.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SlopStudio: configure",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors",
        "-ConfigureOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Run Meson's configure step again. The build tasks only need this after a change Meson cannot see, such as a new Qt."
    },
    {
      "label": "SlopStudio: build app",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors",
        "-AppOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Configure if needed, then compile what changed and link the studio and its catalogues. Leaves the test programs alone."
    },
    {
      "label": "SlopStudio: compile",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors",
        "-SkipTests",
        "-SkipValidation"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Configure if needed, then compile what changed, test programs included, with warnings as errors."
    },
    {
      "label": "SlopStudio: build and validate",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "The full check before a commit: configure if needed, compile what changed with warnings as errors, run the Meson tests, and run the repository validation scripts."
    },
    {
      "label": "SlopStudio: test",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/meson_build.ps1",
        "-BuildDir",
        "${workspaceFolder}/builddir",
        "-Backend",
        "ninja",
        "-WarningLevel",
        "2",
        "-WarningsAsErrors",
        "-SkipValidation"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "detail": "Compile what changed, then run the Meson tests with Qt on PATH (skips repository validation)."
    },
    {
      "label": "SlopStudio: build and launch app",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/launch-slopstudio.ps1"
      ],
      "dependsOn": "SlopStudio: build app",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Build the studio, then launch it with Qt on PATH."
    },
    {
      "label": "SlopStudio: launch app (no build)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/launch-slopstudio.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Launch the already-built app. This task never configures, compiles, or tests."
    },
    {
      "label": "SlopStudio: launch CLI help (no build)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/launch-slopstudio.ps1",
        "-CliHelp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Launch the already-built CLI help. This task never configures, compiles, or tests."
    },
    {
      "label": "SlopStudio: build docs site",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/build_docs_site.py",
        "--output",
        "${workspaceFolder}/build/docs-site"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Render docs/manual as the HTML documentation in build/docs-site (fails on broken links)."
    },
    {
      "label": "SlopStudio: regenerate branding",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/generate_branding.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Rebuild every logo, icon and installer image under assets/branding (docs/BRANDING.md)."
    },
    {
      "label": "SlopStudio: check changelog and version",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/changelog.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Validate CHANGELOG.md (docs/RELEASING.md)."
    }
  ]
}
